# Local Compose development values. Replace every value before production use.
APP_ENV=development
DATABASE_URL=sqlite:////app/data/budget.db
SESSION_SECRET=development-only-replace-before-production
SESSION_MAX_AGE_DAYS=30
ALLOWED_ORIGINS=https://localhost
TRUSTED_HOSTS=localhost,127.0.0.1
SECURE_COOKIES=false
BUDGET_HOST=localhost
HTTPS_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
